$pdo_options = [];
{{- /*
  TLS for the database connections. Presence of certificates determines
  the TLS mode:
    client cert + key      -> client certificate auth (MySQL REQUIRE X509)
    ca.pem                 -> enable TLS (MySQL REQUIRE SSL)
    DESKPRO_DB_SSL_ENABLED -> encryption with no certs at all (REQUIRE SSL)

  The read and read_reports connections can be different servers behind
  different CAs, so each resolves its own settings if certificates are present.
*/}}
{{- define "pdoSslOptions"}}
{{- if .enabled}}
    {{.var}}[\PDO::MYSQL_ATTR_SSL_VERIFY_SERVER_CERT] = {{if .verify}}true{{else}}false{{end}};
    {{.var}}[\PDO::MYSQL_ATTR_SSL_CA] = {{if .ca}}{{.ca | squote}}{{else}}'/etc/ssl/certs'{{end}};
{{- if .clientCrt}}
    {{.var}}[\PDO::MYSQL_ATTR_SSL_CERT] = "{{.clientCrt}}";
    {{.var}}[\PDO::MYSQL_ATTR_SSL_KEY] = "{{.clientKey}}";
{{- end}}
{{end}}
{{- end}}
{{- $mysql_client_crt := "/srv/deskpro/INSTANCE_DATA/mysql-client.crt" }}
{{- $mysql_client_key := "/srv/deskpro/INSTANCE_DATA/mysql-client.key" }}
{{- $mysql_ca := "/srv/deskpro/INSTANCE_DATA/mysql-ca.pem" }}
{{- $has_client_cert := and (file.Exists $mysql_client_crt) (file.Exists $mysql_client_key) }}
{{- $has_ca := file.Exists $mysql_ca }}
{{- $ssl_primary := coll.Dict
      "var" "$pdo_options"
      "enabled" (or $has_client_cert $has_ca (conv.ToBool (getenv "DESKPRO_DB_SSL_ENABLED" "false")))
      "verify" (conv.ToBool (getenv "DESKPRO_DB_SSL_VERIFY_SERVER_CERT" "false"))
      "ca" (test.Ternary $mysql_ca "" $has_ca)
      "clientCrt" (test.Ternary $mysql_client_crt "" $has_client_cert)
      "clientKey" (test.Ternary $mysql_client_key "" $has_client_cert) }}

{{template "pdoSslOptions" $ssl_primary}}

