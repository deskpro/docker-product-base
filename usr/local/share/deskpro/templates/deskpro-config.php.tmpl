{{- $read_ca := "/srv/deskpro/INSTANCE_DATA/mysql-read-ca.pem" }}
{{- $read_own_client_cert := and (file.Exists $read_client_crt) (file.Exists $read_client_key) }}
{{- $read_own_ca := file.Exists $read_ca }}
{{- /* any certificate of its own makes this connection's directory authoritative */}}
{{- $read_own := or $read_own_ca (file.Exists $read_client_crt) (file.Exists $read_client_key) }}
{{- $read_use_ca := test.Ternary (test.Ternary $read_ca "" $read_own_ca) $ssl_primary.ca $read_own }}
{{- $read_use_crt := test.Ternary (test.Ternary $read_client_crt "" $read_own_client_cert) $ssl_primary.clientCrt $read_own }}
{{- $read_use_key := test.Ternary (test.Ternary $read_client_key "" $read_own_client_cert) $ssl_primary.clientKey $read_own }}
{{- $read_enabled_env := getenv "DESKPRO_DB_READ_SSL_ENABLED" }}
{{- $read_verify_env := getenv "DESKPRO_DB_READ_SSL_VERIFY_SERVER_CERT" }}
{{- $ssl_read := coll.Dict
      "var" "$pdo_options_read"
