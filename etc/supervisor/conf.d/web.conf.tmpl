[program:nginx]
command=/usr/sbin/nginx -g "daemon off;"
autostart={{ getenv "SVC_NGINX_ENABLED" "false" | ternary "true" "false" }}
autorestart=true
exitcodes=0
startsecs=1
startretries=3
redirect_stderr=true
stdout_logfile=/var/log/supervisor/nginx.log
stdout_logfile_maxbytes=0 {{/* Our rotate-logs task will handle rotation */}}
stdout_logfile_backups=0
{{if conv.ToBool (getenv "HTTP_INTERNAL_MODE") }}
stopsignal=TERM
stopwaitsecs=0
{{else}}
stopsignal=QUIT
stopwaitsecs={{ getenv "FAST_SHUTDOWN" "false" | ternary "0" "60" }}
{{end}}

[program:php_fpm]
command=/usr/sbin/php-fpm8.3 -F
autostart={{ getenv "SVC_PHP_FPM_ENABLED" "false" | ternary "true" "false" }}
autorestart=true
exitcodes=0
startsecs=1
startretries=3
redirect_stderr=true
stdout_logfile=/var/log/supervisor/php_fpm.log
stdout_logfile_maxbytes=0 {{/* Our rotate-logs task will handle rotation */}}
stdout_logfile_backups=0
{{/* clear_env=no in the pool config means workers inherit this environment as-is */}}
environment=HTTP_PROXY="{{ getenv "HTTP_PROXY" "" }}",http_proxy="{{ getenv "http_proxy" "" }}",HTTPS_PROXY="{{ getenv "HTTPS_PROXY" "" }}",https_proxy="{{ getenv "https_proxy" "" }}",ALL_PROXY="{{ getenv "ALL_PROXY" "" }}",all_proxy="{{ getenv "all_proxy" "" }}",NO_PROXY="{{ getenv "NO_PROXY" "" }}",no_proxy="{{ getenv "no_proxy" "" }}"
{{if conv.ToBool (getenv "HTTP_INTERNAL_MODE") }}
stopsignal=TERM
stopwaitsecs=0
{{else}}
stopsignal=TERM
stopwaitsecs={{ getenv "FAST_SHUTDOWN" "false" | ternary "0" "60" }}
{{end}}
